# Disable script execution inside uploads directory
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php5|php7|php8|phtml|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|php5|php7|php8|phtml|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Turn off directory indexes
Options -Indexes
