# Prevent PHP execution in uploads directory (Security: Block webshell uploads)
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pht|shtml|cgi|pl|py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP engine in this directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Prevent directory browsing
Options -Indexes -ExecCGI
