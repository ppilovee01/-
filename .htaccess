# ----------------------------------------------------------------------
# Por Mae Bet Taled (พ่อแม่ เบ็ดเตล็ด) - Root Security & URL Rewriting
# ----------------------------------------------------------------------

# Enable Rewrite Engine & Hide .php Extension
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Redirect /page.php to /page (External Redirect for clean URL, preserving subdirectory)
    # Skip POST requests to preserve form submissions and AJAX request payloads
    RewriteCond %{REQUEST_METHOD} !POST
    # Skip AJAX centralized router and verification files to prevent redirect overhead/data loss
    RewriteCond %{REQUEST_URI} !ajax\.php
    RewriteCond %{REQUEST_URI} !verify_slip\.php
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^\s?]+)\.php [NC]
    # ป้องกันการวนลูปสำหรับกรณีที่เป็นโฟลเดอร์หรือไฟล์ระบบ
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ %1 [R=302,L]



    # 2. Map /page to /page.php internally (Internal Rewrite)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [L]
</IfModule>



# 1. Prevent Directory Indexing (Disable directory browsing)
Options -Indexes

# 2. Block Direct Access to Sensitive Files and Directories
<FilesMatch "(db\.php|fitness_db\.sql|fitness_dbd\.sql|README\.md|\.git|\.gitignore|composer\.json|composer\.lock|package\.json|package-lock\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Mitigate Application-Layer DDoS & Flood Attacks
# Limit Request Body size to 10MB (wrapped in IfModule for hosting compatibility)
<IfModule mod_core.c>
    LimitRequestBody 10485760
</IfModule>

# Limit HTTP methods to safe/expected actions only
<IfModule mod_authz_core.c>
    <LimitExcept GET POST HEAD>
        Require all denied
    </LimitExcept>
</IfModule>
<IfModule !mod_authz_core.c>
    <LimitExcept GET POST HEAD>
        Order allow,deny
        Deny from all
    </LimitExcept>
</IfModule>

# 4. Implement HTTP Security Headers (Defense-in-depth)
<IfModule mod_headers.c>
    # Prevent MIME Sniffing attacks
    Header set X-Content-Type-Options "nosniff"

    # Prevent Clickjacking attacks
    Header set X-Frame-Options "SAMEORIGIN"

    # Enable browser XSS protection mode
    Header set X-XSS-Protection "1; mode=block"

    # Control Referrer leakage
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
